<?xml version="1.0" encoding="utf-8" ?>
<!--
  AndroidManifest.xml for the Stream Tube Android shell.

  Adapted from the gpui-mobile example template (docs/evidence/B1): the
  launcher activity is dev.gpui.mobile.GpuiActivity — the gpui-mobile
  lineage is GpuiActivity ← GpuiInputActivity ← NativeActivity, and
  GpuiInputActivity supplies the native InputConnection the multi-stage
  IME (Arabic keyboards, Track B6) needs. The native code looks the Java
  helper classes up by their hardcoded dev.gpui.mobile package, so that
  package is kept verbatim while the application id is our own.

  Permissions are the minimal set: networking plus POST_NOTIFICATIONS for the
  enabled `notifications` feature (it is a runtime permission on 13+). No
  camera / contacts / calendar / microphone — those packages are compiled
  out (six-feature build, docs/evidence/B1 §4).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notification permission (required on Android 13+ / API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vulkan feature declaration.
         `required="false"` allows the app to fall back to OpenGL ES on
         devices without Vulkan support. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="0"
    />

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000"
    />

    <!-- GPU hardware acceleration is required for wgpu rendering. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Touchscreen support (virtually all Android devices). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
    />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/GpuiTheme"
    >

        <!--
          GpuiActivity extends GpuiInputActivity extends NativeActivity and
          integrates the AndroidX SplashScreen API. The splash screen is held
          visible until the Rust native library signals readiness via
          NATIVE_INITIALIZED. The Android framework loads the specified native
          library and calls ANativeActivity_onCreate(), which is defined in
          gpui_mobile::android::jni. The spawned Rust thread calls
          android_main() (defined in crates/streamtube-android) to start the
          application.
        -->
        <activity
            android:name="dev.gpui.mobile.GpuiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/GpuiSplashTheme"
            android:windowSoftInputMode="adjustResize"
        >

            <!-- The native library name WITHOUT the "lib" prefix and ".so" suffix.
                 This is set via manifestPlaceholders in build.gradle.kts. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}"
            />

            <!-- Main launcher entry point. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links on the desktop's streamtube: scheme (Track F). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="streamtube" />
            </intent-filter>
        </activity>

        <!-- Directory picker helper (file_selector feature). -->
        <activity
            android:name="dev.gpui.mobile.GpuiPathPicker"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <!-- Transparent helper Activity for file/image picker results. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

        <!-- Transparent helper Activity for runtime permission requests. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

    </application>

</manifest>
